#cloud-config
# Cloud-init configuration for construct VM
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

hostname: {{ construct_hostname }}
fqdn: {{ construct_hostname }}.littlewolfacres.com
manage_etc_hosts: true

users:
  - name: {{ construct_user }}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    plain_text_passwd: 'tempDebug123'
    ssh_authorized_keys:
      - {{ ssh_public_key_construct }}

chpasswd:
  expire: false

# Package installation moved to runcmd with retry logic
# to avoid race conditions with network initialization

write_files:
  - path: /tmp/setup-tailscale.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      
      # Add Tailscale repository
      curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | \
        sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
      
      echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] \
        https://pkgs.tailscale.com/stable/debian bookworm main" | \
        sudo tee /etc/apt/sources.list.d/tailscale.list
      
      sudo apt-get update -qq
      sudo apt-get install -y tailscale
      
      # Authenticate
      sudo tailscale up --authkey={{ tailscale_auth_key }} --accept-routes

  - path: /tmp/setup-dev-tools.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      
      # Install GitHub CLI
      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
        sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
      sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
        https://cli.github.com/packages stable main" | \
        sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
      sudo apt-get update -qq
      sudo apt-get install -y gh
      
      # Install Pi coding agent
      sudo npm install -g @earendil-works/pi-coding-agent
      
      # Install NVM for user
      sudo -u {{ construct_user }} bash -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash'
      
      # Install wmux (placeholder - update with actual install method)
      # TODO: Add wmux installation once source is available

runcmd:
  # Wait for network to be fully ready
  - timeout 60 bash -c 'until ping -c1 archive.ubuntu.com &>/dev/null; do sleep 2; done'
  
  # Update package lists with retries
  - |
    for i in {1..5}; do
      apt-get update && break
      echo "apt-get update failed, retry $i/5"
      sleep 10
    done
  
  # Install base packages with retries
  - |
    for i in {1..3}; do
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl wget git vim tmux jq build-essential \
        python3 python3-pip nodejs npm golang \
        htop net-tools ca-certificates gnupg lsb-release && break
      echo "Package installation failed, retry $i/3"
      sleep 10
    done
  
  - /tmp/setup-tailscale.sh
  - /tmp/setup-dev-tools.sh
  # Temporarily enable password authentication for debugging
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
  - systemctl enable ssh
  - systemctl restart ssh

timezone: UTC

final_message: |
  Construct VM is ready!
  SSH: ssh {{ construct_user }}@{{ construct_hostname }}
  Tailscale should be authenticated and connected.
