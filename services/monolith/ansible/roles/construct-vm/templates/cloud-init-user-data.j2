#cloud-config
# Cloud-init configuration for construct VM
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

hostname: {{ construct_hostname }}
fqdn: {{ construct_hostname }}.littlewolfacres.com
manage_etc_hosts: true

users:
  - name: {{ construct_user }}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    ssh_authorized_keys:
      - {{ ssh_public_key_construct }}

chpasswd:
  list: |
    {{ construct_user }}:tempDebug123
  expire: false

# Package installation moved to runcmd with retry logic
# to avoid race conditions with network initialization

write_files:
  - path: /tmp/setup-tailscale.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Add Tailscale repository
      curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | \
        sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null

      echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] \
        https://pkgs.tailscale.com/stable/debian bookworm main" | \
        sudo tee /etc/apt/sources.list.d/tailscale.list

      sudo apt-get update -qq
      sudo apt-get install -y tailscale

      # Authenticate
      # --accept-dns=false: Tailscale tailnet has no upstream DNS resolvers
      # configured in the admin console, so its stub resolver (100.100.100.100)
      # cannot resolve public domains. We manage /etc/resolv.conf ourselves.
      # TODO: Once upstream DNS is configured in the Tailscale admin console,
      #       remove --accept-dns=false and delete /tmp/setup-dns.sh.
      sudo tailscale up --authkey={{ tailscale_auth_key }} \
        --accept-routes --accept-dns=false

  - path: /tmp/setup-dns.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      # Tailscale tailnet has no upstream DNS resolvers configured.
      # Use the local DNS server (watchtower) for resolution.
      # See: https://github.com/tailscale/tailscale — admin console DNS settings.
      echo "nameserver {{ construct_dns_server }}" > /etc/resolv.conf
      # Prevent Tailscale or anything else from overwriting resolv.conf
      chattr +i /etc/resolv.conf

  - path: /tmp/setup-dev-tools.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Install GitHub CLI
      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
        sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
      sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
        https://cli.github.com/packages stable main" | \
        sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
      sudo apt-get update -qq
      sudo apt-get install -y gh

      # Install NVM for user and Node.js 22
      # Debian 12 ships Node 18, but pi-coding-agent and wmux require Node 22+.
      # Node 18 lacks crypto.hash() and the regex 'v' flag, causing crashes.
      sudo -u {{ construct_user }} bash -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash'

      # Install Node.js 22 and set as default
      sudo -u {{ construct_user }} bash -c '
        unset npm_config_prefix
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm install 22
        nvm alias default 22
        nvm use default
      '

      # Ensure nvm loads in interactive AND non-interactive shells.
      # N.B.: Debian 12's system npm sets npm_config_prefix=/usr/local, which
      # breaks nvm ("nvm is not compatible with npm_config_prefix"). We unset it
      # before loading nvm so Node 22 is used instead of system Node 18.
      # .bashrc is sourced by interactive non-login bash (tmux, PTY sessions).
      # .profile is sourced by login shells (SSH, bash -lc).
      sudo -u {{ construct_user }} bash -c '
cat >> ~/.bashrc << '\''BASHRCEOF'\''

# nvm
unset npm_config_prefix
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
BASHRCEOF

cat >> ~/.profile << '\''PROFILEEOF'\''

# nvm
unset npm_config_prefix
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
PROFILEEOF
      '

      # Install Pi coding agent using nvm Node 22 (NOT system Node 18)
      sudo -u {{ construct_user }} bash -c '
        unset npm_config_prefix
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm use 22
        npm install -g @earendil-works/pi-coding-agent
      '

      # Install wmux — browser terminal multiplexer
      sudo -u {{ construct_user }} bash -c '
        unset npm_config_prefix
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm use 22
        git clone https://github.com/gisenberg/wmux.git ~/wmux
        cd ~/wmux
        npm install
        npm run build
      '

      # Git config
      sudo -u {{ construct_user }} bash -c '
        git config --global user.name "James Hart"
        git config --global user.email "speddling@gmail.com"
      '

  - path: /tmp/setup-wmux-service.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Enable lingering so systemd user services work without an active login session
      sudo loginctl enable-linger {{ construct_user }}

      # Get the Tailscale IPv4 address and DNS name of this host
      # The IP changes after rebuild, but the DNS name is stable for the machine.
      TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
      if [ -z "$TS_IP" ]; then
        echo "WARNING: no Tailscale IP found; wmux service not created."
        exit 0
      fi
      echo "Tailscale IP: $TS_IP"

      # Try to get the Tailscale MagicDNS name (e.g. construct.tailea7d70.ts.net)
      TS_DNS=$(tailscale status --json 2>/dev/null | python3 -c \
        "import sys,json; print(json.load(sys.stdin).get('Self',{}).get('DNSName',''))" 2>/dev/null)
      if [ -n "$TS_DNS" ]; then
        WMUX_BASE="http://${TS_DNS}:{{ construct_wmux_port }}"
        echo "Tailscale DNS name: $TS_DNS"
      else
        WMUX_BASE="http://${TS_IP}:{{ construct_wmux_port }}"
        echo "No DNS name found, using IP for URL"
      fi

      # Determine nvm Node 22 bin path
      NVM_BIN_PATH=$(sudo -u {{ construct_user }} bash -lc 'unset npm_config_prefix; export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; echo $NVM_BIN' 2>/dev/null)
      if [ -z "$NVM_BIN_PATH" ]; then
        # Fallback: find the node v22 bin under .nvm
        NVM_BIN_PATH=$(ls -d /home/{{ construct_user }}/.nvm/versions/node/v22*/bin 2>/dev/null | head -1)
      fi
      echo "nvm bin path: $NVM_BIN_PATH"

      # Create systemd user service directory
      sudo -u {{ construct_user }} mkdir -p /home/{{ construct_user }}/.config/systemd/user

      # Generate wmux.service with the correct Tailscale IP and nvm PATH
      sudo -u {{ construct_user }} bash -c "cat > /home/{{ construct_user }}/.config/systemd/user/wmux.service << UNIT
[Unit]
Description=wmux browser terminal multiplexer
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/{{ construct_user }}/wmux
Environment=NODE_ENV=development
Environment=PATH=${NVM_BIN_PATH}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WMUX_HOST=${TS_IP}
Environment=WMUX_PORT={{ construct_wmux_port }}
Environment=WMUX_PUBLIC_URL=${WMUX_BASE}
Environment=WMUX_HELPER_URL=http://${TS_IP}:{{ construct_wmux_port }}
Environment=WMUX_ALLOWED_BIND_RANGES=
Environment=WMUX_ALLOWED_HOSTS={{ construct_wmux_allowed_hosts | default("") }}
Environment=WMUX_BROWSER_AUTH_MODE=shared-or-login
Environment=WMUX_AUTOMATION_TOKEN_PATH=
Environment=WMUX_HELPER_TOKEN_PATH=
Environment=WMUX_SCOPED_CREDENTIAL_TTL_MS=
ExecStartPre=/usr/bin/env node scripts/wmux-wait-bind \${WMUX_HOST}
ExecStart=/usr/bin/npm run dev -- --host \${WMUX_HOST} --port \${WMUX_PORT}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
UNIT
"

      # Reload user systemd and enable + start wmux
      sudo -u {{ construct_user }} systemctl --user daemon-reload
      sudo -u {{ construct_user }} systemctl --user enable --now wmux.service

      echo "wmux service created and started on ${WMUX_BASE}"
      echo "Token: $(cat /home/{{ construct_user }}/.wmux/token 2>/dev/null)"

runcmd:
  # Wait for network to be fully ready
  - timeout 60 bash -c 'until ping -c1 archive.ubuntu.com &>/dev/null; do sleep 2; done'

  # Update package lists with retries
  - |
    for i in {1..5}; do
      apt-get update && break
      echo "apt-get update failed, retry $i/5"
      sleep 10
    done

  # Install base packages with retries
  - |
    for i in {1..3}; do
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl wget git vim tmux jq build-essential \
        python3 python3-pip nodejs npm golang \
        htop net-tools ca-certificates gnupg lsb-release iptables-persistent \ && break
      echo "Package installation failed, retry $i/3"
      sleep 10
    done

  - /tmp/setup-tailscale.sh
  - /tmp/setup-dns.sh
  - /tmp/setup-dev-tools.sh
  - /tmp/setup-wmux-service.sh
  # Redirect port 80 → 3478 on Tailscale interface for portless browser access
  # (e.g. http://construct.littlewolfacres.com instead of :3478)
  # Idempotent: skips if rule already exists.
  - iptables -t nat -C PREROUTING -i tailscale0 -p tcp --dport 80 -j REDIRECT --to-port {{ construct_wmux_port }} 2>/dev/null || iptables -t nat -A PREROUTING -i tailscale0 -p tcp --dport 80 -j REDIRECT --to-port {{ construct_wmux_port }}
  # Temporarily enable password authentication for debugging
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
  - systemctl enable ssh
  - systemctl restart ssh

timezone: UTC

final_message: |
  Construct VM is ready!
  SSH: ssh {{ construct_user }}@{{ construct_hostname }}
  Tailscale should be authenticated and connected.
  wmux should be running on port 3478 (accessible via Tailscale IP).
  Browser access: http://construct.littlewolfacres.com/?token=$(cat ~/.wmux/token)
